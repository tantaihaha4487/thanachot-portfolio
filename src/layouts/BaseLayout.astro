---
import Metadata from "../components/Metadata.astro";
import { portfolio } from "../data/portfolio";
import { createProfilePageSchema } from "../data/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = portfolio.seo.title,
  description = portfolio.seo.description,
  canonical = portfolio.seo.canonical,
  image = portfolio.seo.socialImage,
  noindex = false,
} = Astro.props;
const schema = noindex ? undefined : createProfilePageSchema(portfolio);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Metadata
      {title}
      {description}
      {canonical}
      {image}
      xCreator={portfolio.seo.xCreator}
      {noindex}
      {schema}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
